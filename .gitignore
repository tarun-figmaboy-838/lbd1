# ---- OS cruft ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- editors / IDEs ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ---- Claude Code ----
# The game-engineer skill is intentionally committed: it carries the project
# baseline every future edit depends on. Local overrides are not.
.claude/settings.local.json

# ---- node (only used by tools/, never shipped) ----
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json
.npm/

# ---- God Mode output ----
# Layout exports are throwaway inputs to tools/apply_layout.js; the corrected
# values belong in js/data.js, not in version control.
layout_*.json
layout_lbd1_*.json

# ---- backups written by tools/apply_layout.js ----
*.bak
js/data.js.bak

# ---- QA scratch ----
# Screenshots under reports/screenshots/ ARE committed as delivery evidence;
# ad-hoc captures and harness output are not.
qa-result.json
verify*-result.json
align-result.json
probe-result.json
stress-result.json
godtest-result.json
pulse-result.json
*.log
shots/
shots[0-9]/

# ---- build / deploy artefacts ----
dist/
build/
.vercel
.netlify
*.zip
*.tar.gz

# ---- environment ----
.env
.env.*
!.env.example
